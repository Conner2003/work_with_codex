{
 "hosting": {
  "public":"public",
  "ignore":["firebase.json","**/.*","**/node_modules/**"],
  "headers":[
   {"source":"**/*.html","headers":[{"key":"Cache-Control","value":"no-store, max-age=0"}]},
   {"source":"**/*.js","headers":[{"key":"Cache-Control","value":"no-store, max-age=0"}]},
   {"source":"**/*.css","headers":[{"key":"Cache-Control","value":"no-store, max-age=0"}]},
   {"source":"**","headers":[
    {"key":"X-Content-Type-Options","value":"nosniff"},
    {"key":"Referrer-Policy","value":"no-referrer"},
    {"key":"X-Frame-Options","value":"DENY"},
    {"key":"Permissions-Policy","value":"camera=(), microphone=(), geolocation=(), payment=(), interest-cohort=()"},
    {"key":"Content-Security-Policy","value":"default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' https://ipwho.is; media-src 'self'; font-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; object-src 'none'; upgrade-insecure-requests"}
   ]}
  ]
 }
}
